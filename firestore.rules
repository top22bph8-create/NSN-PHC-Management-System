rules_version = '2';
// กฎความปลอดภัย Firestore ของระบบ รพ.สต.บ้านหนองสนม
// สิทธิ์อ้างอิงจากเอกสาร users/{อีเมลตัวพิมพ์เล็ก} ต้องตรงกับ src/lib/roles.js
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.token.email);
    }
    function isActive() {
      return signedIn() && exists(userPath()) && get(userPath()).data.active == true;
    }
    // รวมบทบาทเหลือ 2 แบบ: 'super_admin' กับ 'staff' (ผู้ใช้งาน) ตามที่แจ้ง — ต้องตรงกับ normalizeRole() ใน src/lib/roles.js
    // บัญชีเก่าที่ยังมีค่า role ละเอียด (director/admin_clerk/finance/ฯลฯ) ค้างอยู่ก่อนรวมบทบาท ให้ถือเป็น 'staff' เสมอ
    // โดยอัตโนมัติ (ไม่ต้องไล่แก้ค่าที่บันทึกไว้เดิมทีละคน) ยกเว้น 'super_admin'/'pending' คงค่าเดิมไว้ตรงๆ
    function normRole() {
      let r = get(userPath()).data.role;
      return r == 'super_admin' || r == 'pending' ? r : 'staff';
    }
    function hasRole(list) {
      return isActive() && normRole() in list;
    }

    // ผู้ใช้งานและสิทธิ์ (ทำเนียบบุคลากร)
    match /users/{email} {
      // ผู้ใช้ทุกคนที่ใช้งานอยู่อ่านทำเนียบได้ / อ่านของตัวเองได้เสมอ (เพื่อแสดงหน้าบัญชีถูกระงับ)
      allow read: if signedIn() && (request.auth.token.email == email || isActive());
      // เจ้าของระบบสร้างสิทธิ์ตัวเองครั้งแรกได้ครั้งเดียว
      allow create: if (signedIn()
                        && request.auth.token.email == email
                        && email == 'top22bph8@gmail.com'
                        && request.resource.data.role == 'super_admin')
                    // ผู้ใช้งานสมัครเข้ามาเอง: สร้างได้เฉพาะโปรไฟล์ตัวเอง สถานะ pending/ยังไม่ active เท่านั้น
                    || (signedIn()
                        && request.auth.token.email == email
                        && request.resource.data.role == 'pending'
                        && request.resource.data.active == false)
                    || hasRole(['super_admin']);
      // เจ้าตัวแก้ได้เฉพาะ mustChangePassword เป็น false (หลังเปลี่ยนรหัสผ่านแล้ว)
      allow update: if hasRole(['super_admin'])
                    || (signedIn() && request.auth.token.email == email
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword'])
                        && request.resource.data.mustChangePassword == false);
      allow delete: if hasRole(['super_admin']);
    }

    // ใบลา
    match /leaves/{id} {
      // ดูใบลาของทุกคนได้เฉพาะ Super Admin (viewAll) ส่วนคนทั่วไปดูได้แค่ของตัวเอง
      allow read: if isActive() && (resource.data.userEmail == request.auth.token.email
                                    || hasRole(['super_admin']));
      // ยื่นใบลา สถานะต้องเป็น "รอพิจารณา" (ผู้ใช้งานที่ active ทุกคนยื่นแทนเพื่อนร่วมงานได้เท่ากันหมดตามที่แจ้ง)
      allow create: if isActive() && request.resource.data.status == 'รอพิจารณา';
      // Super Admin แก้/ยกเลิก/พิจารณาแทนใครก็ได้ทุกกรณี (การอนุมัติทางเว็บจำกัดเฉพาะ Super Admin เท่านั้นตามที่แจ้ง
      // ส่วนปุ่มอนุมัติในไลน์กลุ่มยังใช้ Admin SDK ของ Cloud Function แยกต่างหาก ไม่ผ่านกฎนี้ ไม่กระทบ)
      // ส่วนเจ้าของใบลาเองยกเลิกได้เฉพาะใบของตัวเองที่ยังรอพิจารณา
      allow update: if hasRole(['super_admin'])
                    || (isActive() && resource.data.userEmail == request.auth.token.email
                        && resource.data.status == 'รอพิจารณา'
                        && request.resource.data.status == 'ยกเลิก');
      allow delete: if hasRole(['super_admin']);
    }

    // ตั้งค่าระบบ
    match /settings/{id} {
      // settings/lineNotify เก็บ TOKEN สำหรับแจ้งเตือนไลน์ — ห้ามอ่านจากฝั่งไคลเอนต์เด็ดขาด (Cloud Function ใช้ Admin SDK อ่านได้อยู่แล้ว ไม่ผ่านกติกานี้)
      allow read: if isActive() && id != 'lineNotify';
      allow write: if hasRole(['super_admin']);
    }
    match /settings/lineNotify {
      allow read: if false;
      allow write: if hasRole(['super_admin']);
    }

    // ตัวนับเลขทะเบียน (สิทธิ์จริงบังคับที่ทะเบียนปลายทางแต่ละอันด้านล่างอยู่แล้ว)
    match /counters/{id} {
      allow read: if isActive();
      allow create, update: if isActive();
    }

    // ทะเบียนหนังสือรับ / หนังสือส่ง
    match /incoming/{id} {
      allow read: if isActive();
      allow create, update, delete: if isActive();
    }
    match /outgoing/{id} {
      allow read: if isActive();
      allow create, update, delete: if isActive();
    }

    // ทะเบียนควบคุมยานพาหนะ
    // รวมบทบาทเหลือ 2 แบบแล้ว (Super Admin/ผู้ใช้งาน) — ผู้ใช้งานที่ active ทุกคนแก้ไขทะเบียนต่างๆ ด้านล่างได้เท่ากันหมด
    // ไม่แยกตามแผนกอีกต่อไปตามที่แจ้ง (hasRole(['super_admin','staff']) เทียบเท่า isActive() พอดี ใช้ isActive() ตรงๆ)
    match /vehicle/{id} {
      allow read: if isActive();
      allow create, update, delete: if isActive();
    }

    // แผนปฏิบัติงานเวรนอกเวลาประจำเดือน
    match /duty/{id} {
      allow read: if isActive();
      allow create, update, delete: if isActive();
    }

    // แผน/รายงานการเยี่ยมบ้านเชิงรุกในชุมชนประจำเดือน
    match /homevisit/{id} {
      allow read: if isActive();
      allow create, update, delete: if isActive();
    }

    // ทะเบียนประกอบฎีกาและทะเบียนต่างๆ
    match /reg-orders/{id} {
      allow read: if isActive();
      allow create, update, delete: if isActive();
    }
    match /reg-announce/{id} {
      allow read: if isActive();
      allow create, update, delete: if isActive();
    }
    match /reg-procurement/{id} {
      allow read: if isActive();
      allow create, update, delete: if isActive();
    }
    match /reg-contract-no/{id} {
      allow read: if isActive();
      allow create, update, delete: if isActive();
    }
    match /reg-loan/{id} {
      allow read: if isActive();
      allow create, update, delete: if isActive();
    }
    match /reg-cheque/{id} {
      allow read: if isActive();
      allow create, update, delete: if isActive();
    }
    match /reg-receipt/{id} {
      allow read: if isActive();
      allow create, update, delete: if isActive();
    }
    match /reg-deeka/{id} {
      allow read: if isActive();
      allow create, update, delete: if isActive();
    }
    match /reg-certificate/{id} {
      allow read: if isActive();
      allow create, update, delete: if isActive();
    }

    // ปฏิทินมอบหมายงาน (ประชุม/อบรม/หน่วยปฐมพยาบาล/อื่นๆ) — ทุกคนดูและแก้ไข/สร้าง/ลบได้เท่ากันหมด
    // (แจ้งเตือนเข้าไลน์กลุ่มอัตโนมัติทุกวัน 06:00 น. ผ่าน Cloud Function dailyAssignmentReminder — ดู README หัวข้อ "ปฏิทินมอบหมายงาน")
    match /assignments/{id} {
      allow read: if isActive();
      allow create, update, delete: if isActive();
    }

    // Audit Log: เพิ่มได้อย่างเดียว แก้ไข/ลบไม่ได้ อ่านได้เฉพาะ Super Admin
    match /auditLogs/{id} {
      allow read: if hasRole(['super_admin']);
      allow create: if isActive() && request.resource.data.userEmail == request.auth.token.email;
      allow update, delete: if false;
    }

    // สำเนารหัสผ่านปัจจุบัน (plaintext) ของแต่ละบัญชี ให้ Super Admin ดูได้เพื่อแจ้งผู้ใช้งาน
    // แยกออกจาก users/{email} โดยเจตนา เพราะเอกสาร users อ่านได้กว้าง (ทุกคนที่ active) แต่ credentials ต้องเห็นได้เฉพาะ Super Admin เท่านั้น
    match /credentials/{email} {
      allow read, write: if hasRole(['super_admin']);
    }

    // คำขอเปลี่ยน Username/Password ที่ผู้ใช้งานส่งมาจากหน้าล็อกอิน (ยังไม่ได้ล็อกอินตอนส่งคำขอ)
    match /accountChangeRequests/{id} {
      allow create: if request.resource.data.keys().hasOnly(['currentUsername', 'wantUsername', 'wantPassword', 'note', 'status', 'createdAt'])
                    && request.resource.data.status == 'รอดำเนินการ'
                    && request.resource.data.currentUsername is string && request.resource.data.currentUsername.size() > 0;
      allow read, update, delete: if hasRole(['super_admin']);
    }
  }
}
